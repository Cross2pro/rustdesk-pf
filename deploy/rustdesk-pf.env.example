# /etc/rustdesk-pf/rustdesk-pf.env  (chmod 600, owned by root or rustdesk-pf)
# Every CLI flag has an env var; secrets belong here, not in the unit or argv.

# ID / rendezvous server (use an IP if local DNS is fake-ip, see README.md)
RUSTDESK_PF_SERVER=203.0.113.10:21116
# Relay server (default = ID port + 1; set explicitly if your provider differs)
RUSTDESK_PF_RELAY=203.0.113.10:21117
# Server public key
RUSTDESK_PF_KEY=REPLACE_WITH_SERVER_KEY

# Permanent device password: what the official client / rustdesk-pf connect types.
RUSTDESK_PF_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

# Optional: API account login (only needed on servers that require it).
# The serve side does not need a token for registration on stock hbbs;
# controllers (connect / official client) usually do on commercial servers.
#RUSTDESK_PF_API=https://api.example.com:21114
#RUSTDESK_PF_API_HOST=api.example.com
#RUSTDESK_PF_ACCOUNT_USER=
#RUSTDESK_PF_ACCOUNT_PASSWORD=
